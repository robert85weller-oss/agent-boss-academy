# Hostinger (Apache/LiteSpeed) – ersetzt netlify.toml

RewriteEngine On

# Alle Varianten (http, ohne www, .de) → https://www.agent-boss-academy.com
RewriteCond %{HTTP_HOST} !^www\.agent-boss-academy\.com$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} agent-boss-academy\.(com|de)$ [NC]
RewriteRule ^(.*)$ https://www.agent-boss-academy.com/$1 [R=301,L]

# Repo-Interna nicht ausliefern (Git-Deploy legt das ganze Repo in public_html)
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^(docs|_data)(/|$) - [F,L]
RewriteRule ^[^/]+\.(md|MD|toml)$ - [F,L]

Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(woff2|jpg|jpeg|png|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
