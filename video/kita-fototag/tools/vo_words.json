[
 {"text":"Fototag in der Kita! Klingt nach Trubel? ... Muss es nicht. In einer Minute zeig ich dir, wie er für alle entspannt wird.",
  "words":[["Fototag",0.21,0.8],["in",0.853,0.96],["der",1.02,1.2],["Kita!",1.32,1.92],["Klingt",2.053,2.8],["nach",2.816,2.88],["Trubel?",2.933,3.44],["Muss",4.192,4.32],["es",4.373,4.48],["nicht.",4.533,4.88],["In",5.067,5.44],["einer",5.493,5.76],["Minute",5.817,6.16],["zeig",6.24,6.48],["ich",6.52,6.64],["dir,",6.7,7.04],["wie",7.06,7.12],["er",7.173,7.28],["für",7.34,7.52],["alle",7.568,7.76],["entspannt",7.84,8.4],["wird.",8.464,8.76]]},
 {"text":"Zwei bis drei Wochen vorher: ein kurzer Elternbrief mit Termin und Ablauf. Und die Einverständniserklärungen gleich mit einsammeln.",
  "words":[["Zwei",0.07,0.24],["bis",0.3,0.48],["drei",0.528,0.72],["Wochen",0.766,1.04],["vorher:",1.14,1.68],["ein",1.78,2.08],["kurzer",2.14,2.48],["Elternbrief",2.533,3.2],["mit",3.24,3.36],["Termin",3.417,3.76],["und",3.8,3.92],["Ablauf.",3.96,4.56],["Und",4.76,5.36],["die",5.4,5.52],["Einverständniserklärungen",5.58,6.88],["gleich",6.914,7.12],["mit",7.18,7.36],["einsammeln.",7.424,8.04]]},
 {"text":"Tipp für die Eltern: bequeme, einfarbige Kleidung. Große Aufdrucke lenken nur vom Lächeln ab.",
  "words":[["Tipp",0.112,0.16],["für",0.2,0.32],["die",0.36,0.48],["Eltern:",0.56,1.32],["bequeme,",1.413,2.08],["einfarbige",2.16,2.8],["Kleidung.",2.88,3.88],["Große",3.99,4.48],["Aufdrucke",4.56,5.2],["lenken",5.26,5.6],["nur",5.66,5.84],["vom",5.9,6.08],["Lächeln",6.12,6.48],["ab.",6.56,6.95]]},
 {"text":"Fürs Shooting reicht ein ruhiger, heller Raum. Am besten mit Tageslicht.",
  "words":[["Fürs",0.065,0.16],["Shooting",0.213,0.64],["reicht",0.72,1.04],["ein",1.1,1.28],["ruhiger,",1.34,1.92],["heller",1.96,2.16],["Raum.",2.256,2.96],["Am",3.013,3.12],["besten",3.177,3.52],["mit",3.56,3.68],["Tageslicht.",3.72,4.52]]},
 {"text":"Und die Kinder? Erzählt ihnen vorher davon. Wer die Kamera schon kennt, lacht viel lieber hinein.",
